    "NL": {"length": 18, "bban_pattern": "[A-Z]{4}[0-9]{10}", "bank_slice": [4, 8], "lookup_scheme": "NL_BANK_CODE", "lookup_slice": [4, 8]},
    "FR": {"length": 27, "bban_pattern": "[0-9]{10}[A-Z0-9]{11}[0-9]{2}", "bank_slice": [4, 9], "branch_slice": [9, 14], "lookup_scheme": "FR_BANK_BRANCH", "lookup_slice": [4, 14]},
    "ES": {"length": 24, "bban_pattern": "[0-9]{20}", "bank_slice": [4, 8], "branch_slice": [8, 12], "lookup_scheme": "ES_BANK_BRANCH", "lookup_slice": [4, 12]},
    "IT": {"length": 27, "bban_pattern": "[A-Z][0-9]{10}[A-Z0-9]{12}", "bank_slice": [5, 10], "branch_slice": [10, 15], "lookup_scheme": "IT_BANK_BRANCH", "lookup_slice": [5, 15]}
